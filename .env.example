# Export variables into your shell before startup; no implicit .env loading.
AEREO_DATABASE_URL=sqlite:///./data/aereo.db
AEREO_MAX_UPLOAD_BYTES=10485760
AEREO_MAX_UNCOMPRESSED_BYTES=52428800
AEREO_MAX_ARCHIVE_ENTRIES=128
AEREO_MAX_COMPRESSION_RATIO=100
AEREO_MAX_FEATURES=5000
AEREO_MAX_COORDINATES=200000
AEREO_MAX_XML_ELEMENTS=100000
AEREO_MAX_XML_DEPTH=32
PROJ_NETWORK=OFF
